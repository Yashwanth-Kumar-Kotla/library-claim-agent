# Google AI Studio key: Gemini Live, Flash, Pro.
GOOGLE_API_KEY=replace-me
GOOGLE_GENAI_USE_VERTEXAI=False

# Models (defaults shown).
# LIVE_MODEL=gemini-3.8-live
# VISION_MODEL=gemini-3.8-flash
# VISION_ESCALATION_MODEL=gemini-3.1-pro-preview

# Locale. Country is ISO 3166-1 alpha-2; currency is ISO 4217.
COUNTRY=US
CURRENCY=USD

# Price sources.
GOOGLE_BOOKS_API_KEY=
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Or, without eBay developer access: the same eBay searches through SerpApi (serpapi.com, free tier 250/month).
SERPAPI_API_KEY=

# Review rules.
APPRAISAL_THRESHOLD=150
